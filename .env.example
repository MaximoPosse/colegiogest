# Configuración de Supabase para ColegioGest (Vue + Vite)
# Copiá este archivo como .env y completá los valores de TU proyecto Supabase
# (Project Settings -> API). La URL y la publishable/anon key son públicas;
# NUNCA pongas la service_role key ni contraseñas de base en variables VITE_*
# porque se incluyen en el bundle que descarga el navegador.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-publishable-o-anon-key
